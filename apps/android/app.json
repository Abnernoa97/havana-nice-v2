{
  "expo": {
    "name": "HAVANA NICE V2",
    "slug": "havana-nice-v2",
    "version": "0.0.38",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.havananice.v2",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 38,
      "adaptiveIcon": {
        "foregroundImage": "../pwa/public/icons/havana-nice-512.png",
        "backgroundColor": "#0D2A23"
      },
      "icon": "../pwa/public/icons/havana-nice-512.png",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "environment": "development"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir a HAVANA NICE tomar fotos y videos para el Chat.",
          "microphonePermission": "Permitir grabar audio al capturar videos en el Chat.",
          "photosPermission": "Permitir elegir fotos y videos para el Chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir a HAVANA NICE grabar mensajes de voz en los Estados.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#DCCDA8",
          "defaultChannel": "havana-team-activity"
        }
      ]
    ],
    "icon": "../pwa/public/icons/havana-nice-512.png",
    "splash": {
      "image": "../pwa/public/icons/havana-nice-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2A23"
    }
  }
}
