  },
  "dependencies": {
    "@havana/shared": "0.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "page-flip": "2.0.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
